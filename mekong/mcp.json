{
  "mcpServers": {
    "antigravity": {
      "command": "python",
      "args": [
        "-m",
        "antigravity.mcp_server"
      ],
      "env": {}
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "mekong-commands": {
      "command": "python",
      "args": [
        "-m",
        "mekong.mcp_server"
      ],
      "env": {
        "HERMES_HOME": "~/.hermes",
        "MEKONG_HOME": "~/mekong-cli"
      }
    }
  }
}