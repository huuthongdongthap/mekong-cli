{
  "name": "ptp-tech",
  "version": "0.1.0",
  "private": true,
  "description": "PTP Tech — Web app (Cloudflare Pages + Workers)",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:api": "cd api && npx wrangler dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\"",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "npm run build:frontend && cd frontend && npm run deploy"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
