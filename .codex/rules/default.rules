# Mekong CLI — Codex project-level sandbox rules
# Starlark format (loaded by Codex CLI automatically)

# ── Package Managers ──────────────────────────────────────
prefix_rule(pattern=["pnpm", "install"], decision="allow")
prefix_rule(pattern=["pnpm", "run"], decision="allow")
prefix_rule(pattern=["pnpm", "exec"], decision="allow")
prefix_rule(pattern=["pnpm", "add"], decision="allow")
prefix_rule(pattern=["pnpm", "remove"], decision="allow")
prefix_rule(pattern=["pnpm", "list"], decision="allow")
prefix_rule(pattern=["npm", "run"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
prefix_rule(pattern=["npm", "list"], decision="allow")
prefix_rule(pattern=["pip", "install"], decision="allow")
prefix_rule(pattern=["pip3", "install"], decision="allow")
prefix_rule(pattern=["pip", "list"], decision="allow")
prefix_rule(pattern=["pip3", "list"], decision="allow")

# ── Build & Test ──────────────────────────────────────────
prefix_rule(pattern=["make"], decision="allow")
prefix_rule(pattern=["python3", "-m", "pytest"], decision="allow")
prefix_rule(pattern=["python3", "-m", "ruff"], decision="allow")
prefix_rule(pattern=["python3", "-m", "mypy"], decision="allow")
prefix_rule(pattern=["python3", "-m", "build"], decision="allow")
prefix_rule(pattern=["python3", "-m", "pip"], decision="allow")
prefix_rule(pattern=["npx"], decision="allow")
prefix_rule(pattern=["node"], decision="allow")

# ── Git (read) ────────────────────────────────────────────
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")
prefix_rule(pattern=["git", "check-ignore"], decision="allow")
prefix_rule(pattern=["git", "remote"], decision="allow")
prefix_rule(pattern=["git", "tag"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")

# ── Git (write) ───────────────────────────────────────────
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "pull"], decision="allow")
prefix_rule(pattern=["git", "checkout"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "merge"], decision="allow")
prefix_rule(pattern=["git", "rebase"], decision="allow")
prefix_rule(pattern=["git", "stash"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "worktree"], decision="allow")
prefix_rule(pattern=["git", "cherry-pick"], decision="allow")
prefix_rule(pattern=["git", "reset"], decision="allow")

# ── File Ops (read-only) ──────────────────────────────────
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["du"], decision="allow")
prefix_rule(pattern=["stat"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")

# ── Shell Utilities ───────────────────────────────────────
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["printf"], decision="allow")
prefix_rule(pattern=["date"], decision="allow")
prefix_rule(pattern=["env"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")
prefix_rule(pattern=["whoami"], decision="allow")
prefix_rule(pattern=["basename"], decision="allow")
prefix_rule(pattern=["dirname"], decision="allow")
prefix_rule(pattern=["realpath"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")

# ── Text Processing ───────────────────────────────────────
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["tr"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["xargs"], decision="allow")
prefix_rule(pattern=["tee"], decision="allow")

# ── File Ops (write) ──────────────────────────────────────
prefix_rule(pattern=["mkdir"], decision="allow")
prefix_rule(pattern=["touch"], decision="allow")
prefix_rule(pattern=["cp"], decision="allow")
prefix_rule(pattern=["mv"], decision="allow")
prefix_rule(pattern=["ln", "-sfn"], decision="allow")
prefix_rule(pattern=["ln", "-sf"], decision="allow")

# ── Mekong CLI Tools ─────────────────────────────────────
prefix_rule(pattern=["mekong"], decision="allow")
prefix_rule(pattern=["python3", "-m", "src.main"], decision="allow")
prefix_rule(pattern=["python3", "tools/sync_codex_commands.py"], decision="allow")
prefix_rule(pattern=["python3", "tools/sync_codex.py"], decision="allow")
prefix_rule(pattern=["python3", "tools/verify_codex_sync.py"], decision="allow")
prefix_rule(pattern=["python3", "tools/sync_antigravity.py"], decision="allow")
prefix_rule(pattern=["python3", "setup-mekong.py"], decision="allow")
prefix_rule(pattern=["bash", "scripts/health-check.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/mekong-wrapper.sh"], decision="allow")

# ── Docker ────────────────────────────────────────────────
prefix_rule(pattern=["docker", "build"], decision="allow")
prefix_rule(pattern=["docker", "compose"], decision="allow")
prefix_rule(pattern=["docker", "ps"], decision="allow")
prefix_rule(pattern=["docker", "logs"], decision="allow")
prefix_rule(pattern=["docker", "images"], decision="allow")

# ── Forbidden (destructive operations) ────────────────────
prefix_rule(pattern=["rm", "-rf", "/"], decision="forbidden")
prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["chmod", "777"], decision="forbidden")
