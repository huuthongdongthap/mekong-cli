{
  "id": "goals",
  "version": "1.0.0",
  "layer": "founder",
  "chapter": "始計 — Initial Calculations",
  "display": {
    "name_en": "Goals",
    "icon": "",
    "description_en": "Founder goal setting and command configuration"
  },
  "execution": {
    "agents": [
      "strategist",
      "researcher",
      "planner"
    ],
    "hub": "founder-hub",
    "complexity": "standard",
    "timeout_ms": 120000,
    "credit_cost": 3,
    "requires_approval": false
  },
  "input": {
    "type": "object",
    "required": [
      "goal"
    ],
    "properties": {
      "goal": {
        "type": "string",
        "description": "Natural language task description"
      },
      "context": {
        "type": "string",
        "description": "Business context or background"
      },
      "urgency": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "description": "Priority level"
      },
      "provider": {
        "type": "string",
        "enum": [
          "auto",
          "codex",
          "claude",
          "gemini",
          "opencode",
          "aider"
        ],
        "description": "Preferred execution provider"
      },
      "mode": {
        "type": "string",
        "enum": [
          "plan",
          "auto"
        ],
        "description": "Whether to only plan or configure autonomous execution"
      },
      "codex_auto_command": {
        "type": "string",
        "description": "Current Codex CLI auto-mode equivalent"
      },
      "sandbox": {
        "type": "string",
        "enum": [
          "read-only",
          "workspace-write",
          "danger-full-access"
        ],
        "description": "Codex sandbox mode"
      },
      "approval_policy": {
        "type": "string",
        "enum": [
          "untrusted",
          "on-request",
          "never"
        ],
        "description": "Codex approval policy"
      }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string",
        "description": "Executive summary"
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "next_steps": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "command_config": {
        "type": "object",
        "description": "Effective command/adapter configuration"
      },
      "codex_auto_command": {
        "type": "string",
        "description": "Resolved Codex auto-mode command"
      },
      "dag_groups": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "cascade": {
    "triggers": []
  },
  "validation": {
    "output_must_contain": [],
    "min_output_length": 50,
    "max_credit_cost": 5
  }
}
