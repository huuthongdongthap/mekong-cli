// ── Scholarship Fund ──────────────────────────────────────────────

model ScholarshipFund {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String   @db.VarChar(255)
  description       String?  @db.Text
  targetAmountVnd   BigInt
  currentAmountVnd  BigInt   @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  pillars           ScholarshipPillar[]
  allocations       ScholarshipAllocation[]

  @@map("scholarship_funds")
}

model ScholarshipPillar {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fundId            String   @db.Uuid
  fund              ScholarshipFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  name              String   @db.VarChar(255)
  pillarType        String   @db.VarChar(50)
  allocationPercent Float
  budgetVnd         BigInt
  spentVnd          BigInt   @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  allocations       ScholarshipAllocation[]

  @@index([fundId])
  @@map("scholarship_pillars")
}

model ScholarshipAllocation {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fundId            String   @db.Uuid
  fund              ScholarshipFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  pillarId          String   @db.Uuid
  pillar            ScholarshipPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  learnerId         String   @db.Uuid
  amountVnd         BigInt
  academicYear      String   @db.VarChar(20)
  status            String   @default("pending") @db.VarChar(20)
  disbursedAt       DateTime? @db.Timestamptz(6)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@index([fundId])
  @@index([pillarId])
  @@index([learnerId])
  @@index([status])
  @@map("scholarship_allocations")
}
