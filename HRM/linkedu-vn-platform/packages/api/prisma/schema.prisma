generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, uuid_ossp(map: "uuid-ossp", schema: "public")]
}

model Province {
  code        String       @id @db.VarChar(2)
  name        String       @db.VarChar(100)
  nameEn      String?      @db.VarChar(100)
  region      VnRegion
  districts   District[]
  enterprises Enterprise[]
  learners    Learner[]
  schools     School[]

  @@map("provinces")
}

model District {
  id           Int          @default(autoincrement())
  provinceCode String       @db.VarChar(2)
  name         String       @db.VarChar(100)
  type         DistrictType
  province     Province     @relation(fields: [provinceCode], references: [code], onDelete: Cascade)
  enterprises  Enterprise[]
  learners     Learner[]
  schools      School[]

  @@id([provinceCode, id])
  @@map("districts")
}

model User {
  id                     String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                  String?                 @unique @db.VarChar(255)
  phone                  String?                 @unique @db.VarChar(20)
  passwordHash           String                  @db.VarChar(255)
  emailVerified          Boolean                 @default(false)
  phoneVerified          Boolean                 @default(false)
  role                   UserRole
  schoolId               String?                 @db.Uuid
  enterpriseId           Int?
  firstName              String                  @db.VarChar(100)
  lastName               String                  @db.VarChar(100)
  avatarUrl              String?
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?               @db.Timestamptz(6)
  auditLogEntries        AuditLog[]              @relation("AuditLogActor")
  documentsUploaded      Document[]              @relation("DocumentUploadedBy")
  enrollmentsApproved    Enrollment[]            @relation("EnrollmentApprovedBy")
  enrollmentsEnrolled    Enrollment[]            @relation("EnrollmentEnrolledBy")
  evaluationsMade        Evaluation[]            @relation("EvaluationMadeBy")
  certificatesIssued     InternshipCertificate[] @relation("CertificateIssuedBy")
  certificatesRevoked    InternshipCertificate[] @relation("CertificateRevokedBy")
  invoicesIssued         Invoice[]               @relation("InvoiceIssuedBy")
  learner                Learner?
  moasApproved           Moa[]                   @relation("MoaApprovedBy")
  moasCreated            Moa[]                   @relation("MoaCreatedBy")
  practiceRecordsCreated PracticeRecord[]        @relation("PracticeRecordCreatedBy")
  programsApproved       Program[]               @relation("ProgramApprovedBy")
  programsCreated        Program[]               @relation("ProgramCreatedBy")
  enterprise             Enterprise?             @relation(fields: [enterpriseId], references: [id])
  school                 School?                 @relation(fields: [schoolId], references: [id])
  chatMessages           ChatMessage[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([schoolId, role])
  @@index([enterpriseId, role])
  @@map("users")
}

model ChatMessage {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String          @db.Uuid
  conversationId String          @db.Uuid
  role           ChatMessageRole
  content        String
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  user           User            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([conversationId])
  @@map("chat_messages")
}

model School {
  id                 String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code               String          @unique @db.VarChar(20)
  name               String          @db.VarChar(255)
  nameEn             String?         @db.VarChar(255)
  schoolType         SchoolType
  address            String?         @db.VarChar(500)
  provinceCode       String?         @db.VarChar(2)
  districtId         Int?
  phone              String?         @db.VarChar(20)
  email              String?         @db.VarChar(255)
  directorName       String?         @db.VarChar(200)
  taxCode            String?         @unique @db.VarChar(20)
  qlgdnnCode         String?         @db.VarChar(50)
  verificationStatus SchoolStatus    @default(pending)
  verificationDocs   Json?
  status             SchoolStatus    @default(active)
  metadata           Json?
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?       @db.Timestamptz(6)
  invoices           Invoice[]
  learners           Learner[]
  moas               Moa[]
  programs           Program[]
  contacts           SchoolContact[]
  district           District?       @relation(fields: [provinceCode, districtId], references: [provinceCode, id])
  province           Province?       @relation(fields: [provinceCode], references: [code])
  users              User[]

  @@index([provinceCode])
  @@index([status])
  @@index([code])
  @@map("schools")
}

model SchoolContact {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId  String   @db.Uuid
  name      String   @db.VarChar(200)
  position  String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_contacts")
}

model Enterprise {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @db.VarChar(255)
  nameEn                 String?                 @db.VarChar(255)
  taxCode                String                  @unique @db.VarChar(20)
  industry               EnterpriseIndustry
  address                String?                 @db.VarChar(500)
  provinceCode           String?                 @db.VarChar(2)
  districtId             Int?
  phone                  String?                 @db.VarChar(20)
  email                  String?                 @db.VarChar(255)
  website                String?                 @db.VarChar(255)
  contactName            String?                 @db.VarChar(200)
  contactPosition        String?                 @db.VarChar(100)
  contactPhone           String?                 @db.VarChar(20)
  contactEmail           String?                 @db.VarChar(255)
  employeeCount          Int?
  description            String?
  logoUrl                String?
  coverImageUrl          String?
  status                 EnterpriseStatus        @default(pending)
  metadata               Json?
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?               @db.Timestamptz(6)
  contacts               EnterpriseContact[]
  district               District?               @relation(fields: [provinceCode, districtId], references: [provinceCode, id])
  province               Province?               @relation(fields: [provinceCode], references: [code])
  internshipCertificates InternshipCertificate[]
  invoices               Invoice[]
  moas                   Moa[]
  placements             Placement[]
  practiceRecords        PracticeRecord[]
  programs               Program[]
  users                  User[]

  @@index([industry])
  @@index([provinceCode])
  @@index([status])
  @@map("enterprises")
}

model EnterpriseContact {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  enterpriseId Int
  name         String     @db.VarChar(200)
  position     String?    @db.VarChar(100)
  department   String?    @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  email        String?    @db.VarChar(255)
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@index([enterpriseId])
  @@map("enterprise_contacts")
}

model Moa {
  id            Int        @id @default(autoincrement())
  code          String     @unique @db.VarChar(30)
  schoolId      String     @db.Uuid
  enterpriseId  Int
  title         String     @db.VarChar(255)
  scope         String?
  content       String?
  terms         Json?
  signedDate    DateTime?  @db.Date
  expiresDate   DateTime?  @db.Date
  signedDocUrl  String?
  signedDocHash String?    @db.VarChar(64)
  status        MoaStatus  @default(draft)
  createdById   String     @db.Uuid
  approvedById  String?    @db.Uuid
  approvedAt    DateTime?  @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?  @db.Timestamptz(6)
  approvedBy    User?      @relation("MoaApprovedBy", fields: [approvedById], references: [id])
  createdBy     User       @relation("MoaCreatedBy", fields: [createdById], references: [id])
  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id])
  school        School     @relation(fields: [schoolId], references: [id])
  programs      Program[]

  @@index([schoolId, status])
  @@index([enterpriseId, status])
  @@index([status])
  @@map("moa")
}

model Program {
  id                     Int                     @id @default(autoincrement())
  code                   String                  @unique @db.VarChar(30)
  schoolId               String                  @db.Uuid
  enterpriseId           Int
  moaId                  Int?
  name                   String                  @db.VarChar(255)
  nameEn                 String?                 @db.VarChar(255)
  programType            ProgramType
  field                  ProgramField
  qualificationLevel     QualificationLevel
  durationMonths         Int?
  maxLearners            Int?
  enrolledCount          Int                     @default(0)
  startDate              DateTime?               @db.Date
  endDate                DateTime?               @db.Date
  applicationDeadline    DateTime?               @db.Date
  tuitionFeeVnd          Int?
  description            String?
  requirements           Json?
  curriculum             Json?
  moetRegistrationNo     String?                 @db.VarChar(50)
  status                 ProgramStatus           @default(draft)
  createdById            String                  @db.Uuid
  approvedById           String?                 @db.Uuid
  approvedAt             DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?               @db.Timestamptz(6)
  enrollments            Enrollment[]
  internshipCertificates InternshipCertificate[]
  placements             Placement[]             @relation("PlacementProgram")
  approvedBy             User?                   @relation("ProgramApprovedBy", fields: [approvedById], references: [id])
  createdBy              User                    @relation("ProgramCreatedBy", fields: [createdById], references: [id])
  enterprise             Enterprise              @relation(fields: [enterpriseId], references: [id])
  moa                    Moa?                    @relation(fields: [moaId], references: [id])
  school                 School                  @relation(fields: [schoolId], references: [id])

  @@index([schoolId, status])
  @@index([enterpriseId, status])
  @@index([field])
  @@index([status])
  @@map("programs")
}

model Learner {
  id                     String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                 String?                 @unique @db.Uuid
  schoolId               String                  @db.Uuid
  schoolCode             String?                 @db.VarChar(20)
  nationalId             String                  @unique
  fullName               String                  @db.VarChar(200)
  birthDate              DateTime?               @db.Date
  gender                 LearnerGender
  address                String?                 @db.VarChar(500)
  provinceCode           String?                 @db.VarChar(2)
  districtId             Int?
  phone                  String?
  email                  String?
  schoolMajor            String?                 @db.VarChar(100)
  graduationYear         Int?
  gpa                    Float?
  skills                 String[]
  certifications         Json?
  resumeUrl              String?
  coverLetterUrl         String?
  emergencyContact       Json?
  status                 LearnerStatus           @default(active)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?               @db.Timestamptz(6)
  educations             Education[]             @relation("LearnerEducations")
  enrollments            Enrollment[]
  evaluations            Evaluation[]
  internshipCertificates InternshipCertificate[] @relation("LearnerInternshipCertificates")
  profile                LearnerProfile?
  district               District?               @relation(fields: [provinceCode, districtId], references: [provinceCode, id])
  province               Province?               @relation(fields: [provinceCode], references: [code])
  school                 School                  @relation(fields: [schoolId], references: [id])
  user                   User?                   @relation(fields: [userId], references: [id])
  placements             Placement[]
  practiceRecords        PracticeRecord[]
  workExperiences        WorkExperience[]        @relation("LearnerWorkExperiences")

  @@index([schoolId, status])
  @@index([provinceCode])
  @@index([status])
  @@map("learners")
}

model Enrollment {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  enrollmentNo          String                 @unique @db.VarChar(30)
  programId             Int
  learnerId             String                 @db.Uuid
  enrolledById          String?                @db.Uuid
  enrollmentType        EnrollmentType
  examScore             Float?
  examDate              DateTime?              @db.Date
  examNotes             Json?
  enrolledAt            DateTime               @default(now()) @db.Timestamptz(6)
  practiceStart         DateTime?              @db.Date
  practiceEnd           DateTime?              @db.Date
  evaluationScore       Float?
  evaluationRubric      Json?
  status                EnrollmentStatus       @default(pending)
  approvedById          String?                @db.Uuid
  approvedAt            DateTime?              @db.Timestamptz(6)
  rejectionReason       String?
  approvedBy            User?                  @relation("EnrollmentApprovedBy", fields: [approvedById], references: [id])
  enrolledBy            User?                  @relation("EnrollmentEnrolledBy", fields: [enrolledById], references: [id])
  learner               Learner                @relation(fields: [learnerId], references: [id])
  program               Program                @relation(fields: [programId], references: [id])
  evaluations           Evaluation[]
  internshipCertificate InternshipCertificate? @relation("EnrollmentInternshipCertificate")
  placements            Placement[]
  practiceRecords       PracticeRecord[]

  @@unique([programId, learnerId])
  @@index([programId, status])
  @@index([learnerId, status])
  @@index([status])
  @@map("enrollments")
}

model PracticeRecord {
  id                     String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  enrollmentId           String     @db.Uuid
  learnerId              String     @db.Uuid
  enterpriseId           Int
  practiceDate           DateTime   @db.Date
  activities             String
  hoursWorked            Float
  supervisorName         String     @db.VarChar(200)
  supervisorSignatureUrl String?
  skillsDemonstrated     String[]
  feedback               String?
  rating                 Int?
  createdById            String     @db.Uuid
  createdAt              DateTime   @default(now()) @db.Timestamptz(6)
  createdBy              User       @relation("PracticeRecordCreatedBy", fields: [createdById], references: [id])
  enrollment             Enrollment @relation(fields: [enrollmentId], references: [id])
  enterprise             Enterprise @relation(fields: [enterpriseId], references: [id])
  learner                Learner    @relation(fields: [learnerId], references: [id])

  @@index([enrollmentId, practiceDate])
  @@index([learnerId, practiceDate])
  @@map("practice_records")
}

model Evaluation {
  id             Int            @id @default(autoincrement())
  enrollmentId   String         @db.Uuid
  learnerId      String         @db.Uuid
  evaluatorId    String         @db.Uuid
  evaluationType EvaluationType
  rubric         Json?
  totalScore     Float?
  maxScore       Float?
  percentage     Float?
  feedback       String?
  strengths      String[]
  improvements   String[]
  evidenceDocUrl String?
  evaluatedAt    DateTime?      @default(now()) @db.Timestamptz(6)
  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  evaluator      User           @relation("EvaluationMadeBy", fields: [evaluatorId], references: [id])
  learner        Learner        @relation(fields: [learnerId], references: [id])

  @@index([enrollmentId, evaluationType])
  @@map("evaluations")
}

model Placement {
  id                     Int             @id @default(autoincrement())
  enrollmentId           String          @db.Uuid
  learnerId              String          @db.Uuid
  programId              Int
  enterpriseId           Int
  positionApplied        String?         @db.VarChar(200)
  positionOffered        String?         @db.VarChar(200)
  employmentType         EmploymentType?
  salaryMinVnd           Int?
  salaryMaxVnd           Int?
  acceptedAt             DateTime?       @db.Date
  startDate              DateTime?       @db.Date
  endDate                DateTime?       @db.Date
  tracking3mStatus       String?         @db.VarChar(50)
  tracking3mDate         DateTime?       @db.Date
  tracking3mNotes        String?
  tracking6mStatus       String?         @db.VarChar(50)
  tracking6mDate         DateTime?       @db.Date
  tracking6mNotes        String?
  learnerSatisfaction    Int?
  enterpriseSatisfaction Int?
  learnerFeedback        String?
  enterpriseFeedback     String?
  isCurrentJob           Boolean         @default(false)
  endedAt                DateTime?       @db.Date
  status                 PlacementStatus @default(in_progress)
  createdAt              DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(6)
  enrollment             Enrollment      @relation(fields: [enrollmentId], references: [id])
  enterprise             Enterprise      @relation(fields: [enterpriseId], references: [id])
  learner                Learner         @relation(fields: [learnerId], references: [id])
  program                Program         @relation("PlacementProgram", fields: [programId], references: [id])

  @@index([enterpriseId, status])
  @@index([learnerId, status])
  @@index([programId])
  @@map("placements")
}

model Invoice {
  id                  Int                  @id @default(autoincrement())
  invoiceNumber       String               @unique @db.VarChar(30)
  schoolId            String?              @db.Uuid
  enterpriseId        Int?
  amountVnd           Int
  taxAmountVnd        Int                  @default(0)
  totalVnd            Int
  issueDate           DateTime             @db.Date
  dueDate             DateTime             @db.Date
  paidDate            DateTime?            @db.Date
  status              InvoiceStatus        @default(draft)
  paymentMethod       PaymentMethod?
  paymentReference    String?              @db.VarChar(100)
  invoiceItems        Json?
  relatedEntityType   String?              @db.VarChar(50)
  relatedEntityId     String?
  issuedById          String               @db.Uuid
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?            @db.Timestamptz(6)
  billingSchedules    BillingSchedule[]
  enterprise          Enterprise?          @relation(fields: [enterpriseId], references: [id])
  issuedBy            User                 @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  school              School?              @relation(fields: [schoolId], references: [id])
  paymentTransactions PaymentTransaction[]

  @@index([schoolId, status])
  @@index([enterpriseId, status])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  actorId    String      @db.Uuid
  actorRole  UserRole
  action     AuditAction
  entityType String      @db.VarChar(50)
  entityId   String
  changes    Json?
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?
  requestId  String      @db.Uuid
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  actor      User        @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Document {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  entityType       String       @db.VarChar(50)
  entityId         String
  documentType     DocumentType
  filename         String       @db.VarChar(255)
  originalFilename String       @db.VarChar(255)
  fileSize         Int
  mimeType         String       @db.VarChar(100)
  r2Bucket         String       @db.VarChar(100)
  r2Key            String       @db.VarChar(500)
  r2Url            String?      @db.VarChar(500)
  uploadedById     String       @db.Uuid
  uploadedAt       DateTime     @default(now()) @db.Timestamptz(6)
  sha256Hash       String       @db.VarChar(64)
  metadata         Json?
  uploadedBy       User         @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@map("documents")
}

model LearnerProfile {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  learnerId       String            @unique @db.Uuid
  bio             String?
  skills          String[]
  languages       Json?
  careerObjective String?
  portfolioUrl    String?           @db.VarChar(500)
  linkedinUrl     String?           @db.VarChar(500)
  githubUrl       String?           @db.VarChar(500)
  websiteUrl      String?           @db.VarChar(500)
  visibility      ProfileVisibility @default(private)
  cvTemplate      String?           @default("default")
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  educations      Education[]
  learner         Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  workExperiences WorkExperience[]

  @@index([learnerId])
  @@map("learner_profiles")
}

model WorkExperience {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  learnerProfileId String         @db.Uuid
  learnerId        String         @db.Uuid
  companyName      String         @db.VarChar(255)
  position         String         @db.VarChar(255)
  location         String?        @db.VarChar(255)
  startDate        DateTime       @db.Date
  endDate          DateTime?      @db.Date
  isCurrent        Boolean        @default(false)
  description      String?
  skills           String[]
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  learner          Learner        @relation("LearnerWorkExperiences", fields: [learnerId], references: [id])
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)

  @@index([learnerProfileId])
  @@index([learnerId])
  @@map("work_experiences")
}

model Education {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  learnerProfileId String         @db.Uuid
  learnerId        String         @db.Uuid
  institution      String         @db.VarChar(255)
  degree           String         @db.VarChar(255)
  fieldOfStudy     String?        @db.VarChar(255)
  location         String?        @db.VarChar(255)
  startDate        DateTime       @db.Date
  endDate          DateTime?      @db.Date
  isCurrent        Boolean        @default(false)
  gpa              String?        @db.VarChar(20)
  description      String?
  achievements     String[]
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  learner          Learner        @relation("LearnerEducations", fields: [learnerId], references: [id])
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)

  @@index([learnerProfileId])
  @@index([learnerId])
  @@map("educations")
}

model InternshipCertificate {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  learnerId         String            @db.Uuid
  enrollmentId      String            @unique @db.Uuid
  enterpriseId      Int
  programId         Int
  certificateNumber String            @unique @db.VarChar(50)
  issueDate         DateTime          @db.Date
  startDate         DateTime          @db.Date
  endDate           DateTime          @db.Date
  totalHours        Int
  position          String            @db.VarChar(255)
  department        String?           @db.VarChar(255)
  supervisorName    String            @db.VarChar(255)
  supervisorTitle   String?           @db.VarChar(255)
  evaluationScore   Int?
  evaluationComment String?
  skillsAcquired    String[]
  achievements      String[]
  certificateUrl    String?           @db.VarChar(500)
  qrCodeUrl         String?           @db.VarChar(500)
  status            CertificateStatus @default(draft)
  issuedById        String            @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  revokedAt         DateTime?         @db.Timestamptz(6)
  revokedById       String?           @db.Uuid
  enrollment        Enrollment        @relation("EnrollmentInternshipCertificate", fields: [enrollmentId], references: [id])
  enterprise        Enterprise        @relation(fields: [enterpriseId], references: [id])
  issuedBy          User              @relation("CertificateIssuedBy", fields: [issuedById], references: [id])
  learner           Learner           @relation("LearnerInternshipCertificates", fields: [learnerId], references: [id], onDelete: Cascade)
  program           Program           @relation(fields: [programId], references: [id])
  revokedBy         User?             @relation("CertificateRevokedBy", fields: [revokedById], references: [id])

  @@index([learnerId])
  @@index([enterpriseId])
  @@index([enrollmentId])
  @@index([certificateNumber])
  @@index([status])
  @@map("internship_certificates")
}

model CertificateTemplate {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String   @unique @db.VarChar(100)
  description  String?
  htmlTemplate String
  cssStyles    String?
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("certificate_templates")
}

model PricingTier {
  id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String           @unique @db.VarChar(50)
  segment       Segment
  tierLevel     PricingTierLevel
  basePriceVnd  Int
  setupFeeVnd   Int?
  features      Json
  limits        Json
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  quotes        PriceQuote[]
  pricingRules  PricingRule[]
  subscriptions Subscription[]

  @@index([segment, isActive])
  @@map("pricing_tiers")
}

model PricingRule {
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tierId    String      @db.Uuid
  ruleType  RuleType
  config    Json
  startDate DateTime?   @db.Timestamptz(6)
  endDate   DateTime?   @db.Timestamptz(6)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  tier      PricingTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@map("pricing_rules")
}

model PriceQuote {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  entityId      String
  entityType    Segment
  appliedRules  Json
  finalPriceVnd Int
  currency      String      @default("VND")
  validUntil    DateTime    @db.Timestamptz(6)
  status        QuoteStatus @default(DRAFT)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)
  tierId        String      @db.Uuid
  tier          PricingTier @relation(fields: [tierId], references: [id])

  @@index([entityId, entityType])
  @@map("price_quotes")
}

model PaymentGateway {
  id           String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String               @unique @db.VarChar(50)
  type         GatewayType
  config       Json
  isActive     Boolean              @default(true)
  isTestMode   Boolean              @default(true)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)
  transactions PaymentTransaction[]

  @@map("payment_gateways")
}

model PaymentTransaction {
  id           String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoiceId    Int?
  amountVnd    Int
  currency     String            @default("VND")
  status       TransactionStatus @default(PENDING)
  gatewayRef   String?           @db.VarChar(100)
  responseData Json?
  errorMessage String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  completedAt  DateTime?         @db.Timestamptz(6)
  gatewayId    String            @db.Uuid
  gateway      PaymentGateway    @relation(fields: [gatewayId], references: [id])
  invoice      Invoice?          @relation(fields: [invoiceId], references: [id])

  @@index([gatewayId, status])
  @@index([invoiceId])
  @@map("payment_transactions")
}

model Subscription {
  id                 String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  entityId           String
  entityType         Segment
  status             SubStatus         @default(ACTIVE)
  billingCycle       BillingCycle      @default(MONTHLY)
  currentPeriodStart DateTime          @db.Timestamptz(6)
  currentPeriodEnd   DateTime          @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean           @default(false)
  cancelledAt        DateTime?         @db.Timestamptz(6)
  trialEnd           DateTime?         @db.Timestamptz(6)
  metadata           Json?
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)
  tierId             String            @db.Uuid
  billingSchedules   BillingSchedule[]
  tier               PricingTier       @relation(fields: [tierId], references: [id])

  @@index([entityId, entityType, status])
  @@map("subscriptions")
}

model BillingSchedule {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoiceId      Int?
  amountVnd      Int
  status         ScheduleStatus @default(PENDING)
  scheduledAt    DateTime       @db.Timestamptz(6)
  generatedAt    DateTime?      @db.Timestamptz(6)
  metadata       Json?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  subscriptionId String         @db.Uuid
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@index([scheduledAt])
  @@map("billing_schedules")
}

model LegalEntity {
