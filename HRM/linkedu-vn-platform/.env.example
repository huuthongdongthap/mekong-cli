# =========================
# DATABASE (PostgreSQL 16)
# =========================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkededu_dev?schema=public"
DATABASE_URL_POOL="postgresql://postgres:postgres@localhost:5432/linkededu_dev?schema=public&pool_timeout=60&connection_limit=10"

# =========================
# JWT AUTH
# =========================
JWT_SECRET="change-me-to-a-256-bit-random-string-in-production"
JWT_REFRESH_SECRET="change-me-to-a-256-bit-random-string-different-from-above"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# =========================
# OAUTH2 (optional — Google + Microsoft)
# =========================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID="common"

# =========================
# EMAIL (Resend)
# =========================
RESEND_API_KEY="re_xxxx"
EMAIL_FROM="LinkEduVN <no-reply@linkededu.vn>"
EMAIL_FROM_NAME="LinkEduVN"

# =========================
# R2 STORAGE (Cloudflare)
# =========================
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret"
R2_BUCKET="linkededu-dev-files"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# =========================
# AI CHATBOT (OpenAI-compatible)
# =========================
OPENAI_API_KEY="sk-xxxx"
OPENAI_BASE_URL="https://api.openai.com/v1"
CHATBOT_MODEL="gpt-4o-mini"

# =========================
# REDIS
# =========================
REDIS_URL="redis://localhost:6379"

# =========================
# SMS (MoMo/OTP optional)
# =========================
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""

# =========================
# APP
# =========================
NODE_ENV="development"
PORT="3001"
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# =========================
# WEB (Next.js)
# =========================
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
